{
  "schema": "docara.site.v1",
  "title": "SIMAI Framework",
  "preset": "docs",
  "content_root": "content/ru",
  "framework_lock": "simai-framework.lock.json",
  "default_locale": "ru",
  "locales": {
    "missing_page_policy": "skip",
    "ru": {
      "label": "Русский",
      "direction": "ltr",
      "content_root": "content/ru",
      "public_prefix": "ru",
      "fallbacks": []
    },
    "en": {
      "label": "English",
      "direction": "ltr",
      "content_root": "content/en",
      "public_prefix": "en",
      "fallbacks": ["ru"]
    }
  },
  "locale_routing": {
    "strategy": "prefixed",
    "root": "redirect",
    "detect_browser_language": false,
    "legacy_unprefixed_redirects": true
  },
  "translation_tracking": {
    "enabled": true,
    "source_locale": "ru",
    "mode": "publish-current",
    "lock_file": "translations.lock.json"
  },
  "documentation_tracking": {
    "enabled": true,
    "source_locale": "ru",
    "mode": "report",
    "lock_file": "documentation.lock.json",
    "sources": [
      {
        "id": "simai-framework",
        "provider": "simai_framework",
        "framework_lock": "simai-framework.lock.json"
      }
    ]
  },
  "documentation_version": "current",
  "redirects_file": "redirects.json",
  "effects": {
    "catalogue": "https://cdn.jsdelivr.net/gh/simai/ui-effects@e3a6c512f562e214bb33cab79cfac0c8ad1ead4e/",
    "index_sha256": "41dc65f33c5dd5bc519b153bd289de91e4dcf9e1632b0403edfc2f0ad018e2e2"
  },
  "page_transforms": [
    {
      "command": ["node", "scripts/highlight-code.mjs"]
    },
    {
      "command": ["node", "scripts/landing-hero.mjs"]
    }
  ],
  "base_url": "/",
  "discovery": {
    "llms_links": [
      {"title": "Машиночитаемая документация", "path": "ai.json", "description": "Манифест документации для ИИ-агента: закреплённый выпуск Framework и каталоги страниц с исходниками примеров"},
      {"title": "Быстрый старт", "path": "ru/guide/introduction/quick-start/", "description": "Первая страница на Framework"},
      {"title": "Подключение и обновление", "path": "ru/guide/connection/", "description": "Поставка, подключение к проекту, Loader и обновление"},
      {"title": "Smart-компоненты", "path": "ru/guide/smart-components/", "description": "Как подключать, настраивать и создавать Smart-компоненты"},
      {"title": "Стандарты, качество и ИИ", "path": "ru/guide/standards/", "description": "Стандарты Framework, проверка и разработка с ИИ"},
      {"title": "Словарь", "path": "ru/guide/glossary/", "description": "Термины Framework и где о них читать"}
    ]
  },
  "branding": {
    "title": "SIMAI Framework",
    "mode": "compact",
    "size": "large",
    "logo": "assets/docara-mark.svg",
    "favicon": "assets/favicon.ico"
  },
  "layout": {
    "key": "docara.docs",
    "container": {"max": 7},
    "scrollbar": {"preset": "overlay"}
  },
  "settings": {
    "theme": "system",
    "modal_blur": "none",
    "ui_radius": "default"
  },
  "reader_preferences": {
    "enabled": true,
    "view": "side-panel",
    "groups": [
      {
        "id": "appearance",
        "fields": ["appearance.theme", "appearance.modal_blur", "appearance.ui_radius"]
      }
    ]
  },
  "search": {
    "enabled": true,
    "indexed": true
  },
  "reading": {
    "breadcrumbs": true,
    "toc": true,
    "mobile_toc": "auto",
    "toc_depth": 3,
    "previous_next": true
  }
}
