{
    "name": "simai/ui-doc",
    "description": "Public SIMAI Framework documentation built with Docara v2.",
    "type": "project",
    "license": "proprietary",
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/simai/docara.git",
            "no-api": true
        }
    ],
    "require": {
        "php": "^8.2",
        "simai/docara": "^2.6"
    },
    "scripts": {
        "docara:compatibility:apply": "@php scripts/apply-docara-compatibility-patch.php --apply",
        "docara:compatibility:check": "@php scripts/apply-docara-compatibility-patch.php --check",
        "post-install-cmd": "@docara:compatibility:apply",
        "post-update-cmd": "@docara:compatibility:apply"
    },
    "config": {
        "allow-plugins": false,
        "optimize-autoloader": true,
        "platform": {
            "php": "8.2.0"
        },
        "sort-packages": true
    }
}
