{
    "name": "simai/ui-doc",
    "description": "Public SIMAI Framework documentation built with Docara.",
    "type": "project",
    "license": "Apache-2.0",
    "authors": [
        {
            "name": "Rim Zabarov",
            "role": "Creator"
        }
    ],
    "require": {
        "php": "^8.2",
        "simai/docara": "^3.7"
    },
    "scripts": {
        "docs:viewer:check": "@php scripts/audit-example-viewer.php",
        "docs:versions:sync": "@php scripts/sync-framework-documentation-versions.php",
        "docs:versions:check": [
            "@php scripts/sync-framework-documentation-versions.php --check",
            "@php scripts/audit-framework-documentation-versions.php"
        ],
        "docs:components:check": "node scripts/audit-component-documentation-contracts.mjs",
        "docs:utilities:check": [
            "@php scripts/audit-utility-documentation.php",
            "@php scripts/audit-utility-catalog.php"
        ],
        "docs:composition:check": "node scripts/audit-composition-documentation-contract.mjs",
        "docs:check": [
            "@docs:versions:check",
            "@docs:standards:check",
            "@docs:utilities:check",
            "@docs:utility-classes:check",
            "@docs:utility-groups:check",
            "@docs:nesting:check",
            "@docs:components:check",
            "@docs:smart-attributes:check",
            "@docs:smart-reference:check",
            "@docs:example-classes:check",
            "@docs:reference-sections:check",
            "@docs:reference-pages:check",
            "@docs:layout-classes:check",
            "@docs:architecture:check",
            "@docs:composition:check",
            "@php scripts/audit-examples.php",
            "@php scripts/audit-russian-content.php",
            "@php scripts/audit-catalog-groups.php",
            "@docs:reachable:check",
            "@docs:tokens:check",
            "@docs:catalogue-indexes:check",
            "@docs:property-types:check",
            "@docs:usage:check",
            "@php scripts/audit-smart-lessons.php",
            "@php scripts/test-recipe-edition.php"
        ],
        "docs:architecture:check": [
            "@php scripts/audit-guide-information-architecture.php",
            "@php scripts/audit-guide-redirects.php",
            "@php scripts/audit-reference-separation.php"
        ],
        "docs:build": "@php scripts/build-documentation.php",
        "docs:ai:check": "@php scripts/export-ai-documentation.php --check",
        "docs:reachable:check": "@php scripts/audit-every-page-is-reachable.php",
        "docs:tokens:build": "node scripts/build-token-reference.mjs",
        "docs:tokens:check": "node scripts/build-token-reference.mjs --check",
        "docs:recipe:check": "@php scripts/audit-docara-recipe-primary.php",
        "docs:smart-attributes:check": "node scripts/audit-smart-attribute-tables.mjs",
        "docs:smart-reference:build": "node scripts/build-smart-reference.mjs",
        "docs:smart-reference:check": "node scripts/build-smart-reference.mjs --check",
        "docs:example-classes:check": "node scripts/audit-example-classes.mjs",
        "docs:reference-sections:build": "node scripts/build-reference-sections.mjs",
        "docs:reference-sections:check": "node scripts/build-reference-sections.mjs --check",
        "docs:reference-pages:check": "node scripts/audit-reference-pages.mjs",
        "docs:utility-classes:check": "node scripts/audit-utility-classes-exist.mjs",
        "docs:utility-groups:check": "node scripts/audit-utility-groups-documented.mjs",
        "docs:nesting:check": "node scripts/audit-nesting-steps.mjs",
        "docs:layout-classes:check": [
            "node scripts/build-layout-expectations.mjs",
            "node scripts/inline-layout-expectations.mjs"
        ],
        "docs:catalogue-indexes:build": "node scripts/build-catalogue-group-indexes.mjs",
        "docs:catalogue-indexes:check": "node scripts/build-catalogue-group-indexes.mjs --check",
        "docs:property-types:build": "node scripts/build-property-types-reference.mjs",
        "docs:property-types:check": "node scripts/build-property-types-reference.mjs --check",
        "docs:usage:check": "node scripts/build-unit-usage.mjs --check",
        "docs:standards:check": "node scripts/sync-framework-standards.mjs --check"
    },
    "config": {
        "allow-plugins": false,
        "optimize-autoloader": true,
        "platform": {
            "php": "8.2.0"
        },
        "sort-packages": true
    }
}
