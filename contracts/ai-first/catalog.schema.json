{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI First 0.1 catalog",
  "type": "object",
  "properties": {
    "format": {
      "const": "ai-first"
    },
    "formatVersion": {
      "const": "0.1"
    },
    "document": {
      "const": "catalog"
    },
    "revision": {
      "type": "string",
      "minLength": 1
    },
    "requires": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/item"
      },
      "minItems": 0
    },
    "catalogs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/catalogLink"
      },
      "minItems": 0
    },
    "resourceId": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s]+$"
    }
  },
  "required": [
    "format",
    "formatVersion",
    "document",
    "revision",
    "resourceId",
    "items"
  ],
  "additionalProperties": true,
  "$defs": {
    "representation": {
      "type": "object",
      "properties": {
        "href": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\s\\\\]+$"
        },
        "mediaType": {
          "type": "string",
          "pattern": "^[a-z0-9!#$&^_.+-]+/[a-z0-9!#$&^_.+-]+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "role": {
          "enum": [
            "full",
            "summary"
          ]
        },
        "language": {
          "type": "string",
          "pattern": "^[A-Za-z]{1,8}(-[A-Za-z0-9]{1,8})*$"
        }
      },
      "required": [
        "href",
        "mediaType"
      ],
      "additionalProperties": true
    },
    "appliesTo": {
      "type": "object",
      "properties": {
        "product": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s]+$"
        },
        "versions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "product",
        "versions"
      ],
      "additionalProperties": true
    },
    "contract": {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "openapi",
            "mcp",
            "external"
          ]
        },
        "href": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\s\\\\]+$"
        },
        "mediaType": {
          "type": "string",
          "minLength": 1
        },
        "operation": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "type",
        "href",
        "mediaType",
        "operation"
      ],
      "additionalProperties": true
    },
    "capability": {
      "type": "object",
      "properties": {
        "contract": {
          "$ref": "#/$defs/contract"
        },
        "effects": {
          "enum": [
            "read",
            "write",
            "delete",
            "external",
            "unknown"
          ]
        },
        "authorization": {
          "enum": [
            "none",
            "required",
            "unknown"
          ]
        },
        "confirmation": {
          "enum": [
            "required",
            "not-required",
            "unknown"
          ]
        },
        "instructions": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\s\\\\]+$"
        }
      },
      "required": [
        "contract",
        "effects",
        "authorization",
        "confirmation",
        "instructions"
      ],
      "additionalProperties": true
    },
    "item": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s]+$"
        },
        "kind": {
          "enum": [
            "knowledge",
            "capability"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "language": {
          "type": "string",
          "pattern": "^[A-Za-z]{1,8}(-[A-Za-z0-9]{1,8})*$"
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "draft",
            "published",
            "deprecated",
            "withdrawn"
          ]
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\s\\\\]+$"
        },
        "representations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/representation"
          },
          "minItems": 1
        },
        "appliesTo": {
          "$ref": "#/$defs/appliesTo"
        },
        "capability": {
          "$ref": "#/$defs/capability"
        },
        "replacedBy": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s]+$"
        }
      },
      "required": [
        "id",
        "kind",
        "title",
        "description",
        "language",
        "revision",
        "status",
        "source",
        "representations"
      ],
      "additionalProperties": true,
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "capability"
              }
            }
          },
          "then": {
            "required": [
              "capability"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "knowledge"
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "capability"
              ]
            }
          }
        }
      ]
    },
    "catalogLink": {
      "type": "object",
      "properties": {
        "href": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\s\\\\]+$"
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "href",
        "description"
      ],
      "additionalProperties": true
    },
    "route": {
      "type": "object",
      "properties": {
        "scope": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\s\\\\]+$"
        },
        "href": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\s\\\\]+$"
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "scope",
        "href",
        "description"
      ],
      "additionalProperties": true
    },
    "resource": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "language": {
          "type": "string",
          "pattern": "^[A-Za-z]{1,8}(-[A-Za-z0-9]{1,8})*$"
        },
        "scope": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\s\\\\]+$"
        },
        "publisher": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "url": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[^\\s\\\\]+$"
            }
          },
          "required": [
            "name"
          ],
          "additionalProperties": true
        },
        "homepage": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\s\\\\]+$"
        }
      },
      "required": [
        "id",
        "name",
        "description",
        "language",
        "scope",
        "publisher"
      ],
      "additionalProperties": true
    }
  }
}
